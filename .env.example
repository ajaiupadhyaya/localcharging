# ChargeLocal environment
# Copy to .env and fill in keys. Never commit .env (gitignored).

# ── Supabase (client — safe in Expo bundle) ─────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/tnqyioeviefqswcqkavq/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://tnqyioeviefqswcqkavq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Use either legacy "anon" JWT or new "sb_publishable_..." key from API settings

# ── Mapbox (client — public token only) ─────────────────────────────────────
# https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# ── Stripe (client — test publishable key only) ───────────────────────────────
# https://dashboard.stripe.com/test/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── App metadata ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
# Optional: EAS project ID for Expo push (from expo.dev project settings)
# EXPO_PUBLIC_EAS_PROJECT_ID=

# ── Seed script only (never ship in the app bundle) ───────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=

# ── NOT in .env — set as Supabase Edge Function secrets ───────────────────────
# Supabase Dashboard → Project Settings → Edge Functions → Secrets
#
#   OPEN_CHARGE_MAP_API_KEY   → sync-public-stations function
#   STRIPE_SECRET_KEY         → stripe function (sk_test_...)
#   STRIPE_WEBHOOK_SECRET     → optional, for webhooks later
#
# Service role key stays server-side only (Edge Functions / CI / seed), never in the app.
